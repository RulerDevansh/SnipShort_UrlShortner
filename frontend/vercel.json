{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://snipshort-backend.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://snipshort-backend.onrender.com/auth/:path*"
    },
    {
      "source": "/r/:path*",
      "destination": "https://snipshort-backend.onrender.com/r/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
